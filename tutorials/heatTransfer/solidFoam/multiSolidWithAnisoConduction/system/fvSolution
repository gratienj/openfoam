// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    h
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        minIter         1;
        maxIter         100;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors    2;
    residualControl
    {
        h                    1e-4;
    }
}

relaxationFactors
{
    equations
    {
        h                    1.0;
    }
}

