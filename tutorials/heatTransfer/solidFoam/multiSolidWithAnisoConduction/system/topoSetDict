FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // create cellZone zoneC from zoneC.stl
    {
        name        zoneC;
        type        cellZoneSet;
        action      clear;
    }

    {
        name        zoneC;
        type        cellZoneSet;
        action      add;
        source      searchableSurfaceToCell;

        sourceInfo
        {
            surfaceType  triSurfaceMesh;
            surfaceName  zoneC.stl;
        }
    }

    // subtract zoneC from zoneB 
    {
        name        zoneB;
        type        cellZoneSet;
        action      subtract;

        source      zoneToCell;
        zone        zoneC;
    }

);

