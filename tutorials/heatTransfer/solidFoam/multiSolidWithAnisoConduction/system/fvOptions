// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

__templateHeatSource
{
    type            scalarSemiImplicitSource;
    active          true;
}

heatSource
{
    ${__templateHeatSource}

    selectionMode   cellZone;
    cellZone        zoneC;

    volumeMode      absolute;

    sources
    {
        h           ( 100 0 );
    }
}

// * * * * * * * * * * * * * * * * * Cleanup * * * * * * * * * * * * * * * * //

#remove "__.*"

