FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    outlet
    {
        //type            pressureInletOutletVelocity;
        //value           $internalField;
        type            waveTransmissive;
        psi             thermo:psi;
        lInf            1;
        field           p;
        gamma           1.4;
        fieldInf        100000;
        value           $internalField;
    }

    coflowInletBottom
    {
        type            zeroGradient;
    }

    coflowInletTop
    {
        type            zeroGradient;
    }

    bottomWall
    {
        type            zeroGradient;
    }

    topWall
    {
        type            zeroGradient;
    }

    jetInlet
    {
        type            zeroGradient;
    }

    front
    {
        type            cyclic;
    }

    back
    {
        type            cyclic;
    }
}


