FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      OH;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.00021297590642519;
        value           uniform 0.00021297590642519;
    }

    coflowInletBottom
    {
        type            fixedValue;
        value           uniform 0.00021297590642519;
    }

    coflowInletTop
    {
        type            fixedValue;
        value           uniform 0.00021297590642519;
    }

    bottomWall
    {
        type            zeroGradient;
    }

    topWall
    {
        type            zeroGradient;
    }

    jetInlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    front
    {
        type            cyclic;
    }

    back
    {
        type            cyclic;
    }
}


