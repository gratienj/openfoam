FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
/*
combustionModel  EDC;
combustionModel laminar;
active  true;
EDCCoeffs
{
    //version v2005;
    version v2016;
}
*/
combustionModel  FSD;
active           true;

FSDCoeffs
{
    // H2 is the fuel used by the single-step FSD source construction.
    fuel        H2;

    semiImplicit false;

    // Existing FSD model parameters.
    Cv          0.1;
    ftVarMin    1e-4;

    deltaL      4.7497534e-4;
    Ncell       6.0;
    Cs          16.0;
    Fmax        10.0;

     // Colin et al. (2000) thickened-flame efficiency
    //EColin      1.44;
    EColin      1.;

    TFM false;

    // Direct lookup of the Cantera flamelet omega(K) table.
    reactionRateFlameArea  flameletTable;

    flameletTableCoeffs
    {
        tableFile  FSD_H2_flameletTable;

        // Physical lower bound for the consumption rate.
        omegaMin   0.0;

        // The Cantera table starts at K=177.285279 1/s.
        // Below that range, use the first physical flamelet value.
        belowMin   clamp;

        // The last computed point is K=25221.05 1/s.
        // No zero omega point was computed before the continuation stopped,
        // so do NOT invent an extinction extrapolation here.
        aboveMax   clamp;
    }
}

