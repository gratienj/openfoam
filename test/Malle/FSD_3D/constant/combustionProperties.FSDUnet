FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
combustionModel  FSDUnet;
active           true;

FSDCoeffs
{
    // H2 is the fuel used by the single-step FSD source construction.
    fuel        H2;

    semiImplicit false;

    // Existing FSD model parameters.
    Cv          0.1;
    ftVarMin    1e-4;

    deltaL      4.7497534e-4;
    Ncell       6.0;
    Cs          16.0;
    Fmax        10.0;

    EColin      1.;

    TFM false;
}

// ************************************************************************* //
