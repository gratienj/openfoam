FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      N2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.756;

boundaryField
{
    jetInlet
    {
        type            fixedValue;
        value           uniform 0.75;   // phi_g=0.5, both fresh and burnt
    }

    coflowInletBottom
    {
        type            fixedValue;
        value           uniform 0.756;
    }

    coflowInletTop
    {
        type            fixedValue;
        value           uniform 0.756;
    }

    outlet
    {
        type            zeroGradient;
    }

    bottomWall
    {
        type            zeroGradient;
    }

    topWall
    {
        type            zeroGradient;
    }

    front
    {
        type            cyclic;
    }

    back
    {
        type            cyclic;
    }
}


